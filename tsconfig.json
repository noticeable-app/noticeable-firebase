{
  "compilerOptions": {
    "declaration": true,
    "module": "commonjs",
    "noImplicitReturns": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "target": "ES2022"
  },
  "exclude": [
    "dist/",
    "node_modules"
  ],
  "compileOnSave": true,
  "include": [
    "src"
  ]
}
